generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String           @id @default(cuid())
  email         String           @unique
  password      String
  name          String
  usn           String?
  department    String?
  semester      Int?
  college       String?
  avatar        String?
  bio           String?
  phone         String?
  location      String?
  preferredRole String?
  timezone      String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  attackerSessions Session[]       @relation("AttackerSessions")
  defenderSessions Session[]       @relation("DefenderSessions")
  attempts         Attempt[]
  scores           Score[]
  recommendations  Recommendation[]
  analytics        Analytics[]
  quizAttempts     QuizAttempt[]
  assessmentSnapshots AssessmentSnapshot[]

  @@map("users")
}

model Session {
  id                   String    @id @default(cuid())
  sessionCode          String?   @unique
  attackerId           String
  defenderId           String?
  status               String    @default("WAITING_FOR_PARTICIPANT")
  difficulty           String?
  module               String?
  currentScenarioIndex Int       @default(0)
  totalScenarios       Int       @default(5)
  attackerReady        Boolean   @default(false)
  defenderReady        Boolean   @default(false)
  scenarioIds          Json?
  attackerScore        Int       @default(0)
  defenderScore        Int       @default(0)
  createdAt            DateTime  @default(now())
  completedAt          DateTime?

  attacker User  @relation("AttackerSessions", fields: [attackerId], references: [id])
  defender User? @relation("DefenderSessions", fields: [defenderId], references: [id])

  attempts Attempt[]
  events   Event[]
  scores   Score[]
  assessmentSnapshots AssessmentSnapshot[]

  @@map("sessions")
}

model Scenario {
  id             String @id @default(cuid())
  name           String
  description    String
  category       String
  difficulty     String
  targetSystem   String
  context        String
  attackOptions  Json
  defenseOptions Json

  rules    Rule[]
  attempts Attempt[]
  events   Event[]

  @@map("scenarios")
}

model Rule {
  id            String @id @default(cuid())
  scenarioId    String
  attackType    String
  defenseType   String
  outcome       String
  explanation   String
  scoreModifier Int

  scenario Scenario @relation(fields: [scenarioId], references: [id])

  // Guarantees at most one rule row per (scenario, attack, defense) pairing,
  // so runtime resolution can use findUnique (a guaranteed single row or
  // none) instead of findFirst (which does not rule out duplicates).
  @@unique([scenarioId, attackType, defenseType])
  @@map("rules")
}

model Attempt {
  id          String   @id @default(cuid())
  sessionId   String
  scenarioId  String
  userId      String
  role        String
  choice      String
  outcome     String
  score       Int
  timeTaken   Int
  explanation String
  createdAt   DateTime @default(now())

  session  Session  @relation(fields: [sessionId], references: [id])
  scenario Scenario @relation(fields: [scenarioId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  @@map("attempts")
}

model Event {
  id             String   @id @default(cuid())
  turnId         Int
  sessionId      String
  scenarioId     String
  attackerChoice String
  defenderChoice String
  resolvedRule   String
  outcome        String
  score          Int
  timeTaken      Int
  timestamp      DateTime @default(now())

  session  Session  @relation(fields: [sessionId], references: [id])
  scenario Scenario @relation(fields: [scenarioId], references: [id])

  @@map("events")
}

model Score {
  id               String   @id @default(cuid())
  userId           String
  sessionId        String?
  role             String   @default("defender")
  roundNumber      Int?
  totalScore       Int
  correctChoice    Int
  timeEfficiency   Int
  consistency      Int
  repeatedMistakes Int
  createdAt        DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id])
  session Session? @relation(fields: [sessionId], references: [id])

  @@map("scores")
}

// One row per (user, completed session) — written once, at the moment an
// assessment finishes (see sessionActions.advanceRound). This is what backs
// "Performance Over Time" and "Recent Activity" on the Analytics dashboard;
// the Analytics model above is a rolling per-category total updated every
// round, so it has no notion of individual completed assessments or dates.
model AssessmentSnapshot {
  id              String   @id @default(cuid())
  userId          String
  sessionId       String
  role            String // 'attacker' | 'defender'
  module          String?
  totalRounds     Int
  finalScore      Int
  accuracy        Float // % of this role's rounds that were a "win" (breached for attacker, defended for defender)
  correctRounds   Int
  incorrectRounds Int
  averageTime     Float
  completedAt     DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id])
  session Session @relation(fields: [sessionId], references: [id])

  @@map("assessment_snapshots")
}

model Recommendation {
  id          String   @id @default(cuid())
  userId      String
  type        String
  title       String
  description String
  moduleId    String?
  priority    Int
  isCompleted Boolean  @default(false)
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@map("recommendations")
}

model Analytics {
  id              String   @id @default(cuid())
  userId          String
  category        String
  totalAttempts   Int      @default(0)
  correctAttempts Int      @default(0)
  averageTime     Float    @default(0.0)
  accuracy        Float    @default(0.0)
  lastUpdated     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@map("analytics")
}

// Pre-test / Post-test assessment content. Two parallel forms (PRE_A,
// POST_B) so the post-test isn't just the learner re-answering questions
// they already saw. `correctOption` and `explanation` are never sent to the
// client until after an attempt is submitted (see quiz.routes.ts).
model Question {
  id            String  @id @default(cuid())
  questionId    String  @unique // stable external id from the source data (e.g. "q1", "app3")
  question      String
  optionA       String
  optionB       String
  optionC       String
  optionD       String
  correctOption String // 'A' | 'B' | 'C' | 'D'
  topic         String
  moduleTag     String // one of the 5 platform modules — Web Security, Network Security, System Security, Social Engineering, Cryptography
  topicTag      String // normalized topic, e.g. "SQL Injection"
  difficulty    String // 'Easy' | 'Medium' | 'Hard'
  testForm      String // 'PRE_A' | 'POST_B'
  explanation   String // shown in the Learning Summary review, win or lose
  isActive      Boolean @default(true)

  responses QuizResponse[]

  @@map("questions")
}

model QuizAttempt {
  id             String    @id @default(cuid())
  userId         String
  testType       String // 'PRE' | 'POST'
  testForm       String // 'PRE_A' | 'POST_B'
  status         String    @default("in_progress") // 'in_progress' | 'completed'
  score          Int? // correct-answer count, computed server-side on submit
  totalQuestions Int
  startedAt      DateTime  @default(now())
  completedAt    DateTime?

  user      User           @relation(fields: [userId], references: [id])
  responses QuizResponse[]

  @@map("quiz_attempts")
}

model QuizResponse {
  id             String   @id @default(cuid())
  attemptId      String
  questionId     String
  selectedOption String // 'A' | 'B' | 'C' | 'D'
  isCorrect      Boolean
  createdAt      DateTime @default(now())

  attempt  QuizAttempt @relation(fields: [attemptId], references: [id])
  question Question    @relation(fields: [questionId], references: [id])

  @@unique([attemptId, questionId])
  @@map("quiz_responses")
}

model Module {
  id          String @id @default(cuid())
  name        String
  description String
  category    String
  difficulty  String
  duration    Int
  type        String
  content     Json
  order       Int

  lessons Lesson[]

  @@map("modules")
}

model Lesson {
  id       String @id @default(cuid())
  moduleId String
  title    String
  content  String
  type     String
  order    Int

  module Module @relation(fields: [moduleId], references: [id])

  @@map("lessons")
}
