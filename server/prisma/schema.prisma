generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String           @id @default(cuid())
  email         String           @unique
  password      String
  name          String
  usn           String?
  department    String?
  semester      Int?
  college       String?
  avatar        String?
  bio           String?
  phone         String?
  location      String?
  preferredRole String?
  timezone      String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  attackerSessions Session[]       @relation("AttackerSessions")
  defenderSessions Session[]       @relation("DefenderSessions")
  attempts         Attempt[]
  scores           Score[]
  recommendations  Recommendation[]
  analytics        Analytics[]

  @@map("users")
}

model Session {
  id                   String    @id @default(cuid())
  sessionCode          String?   @unique
  attackerId           String
  defenderId           String?
  status               String    @default("WAITING_FOR_PARTICIPANT")
  difficulty           String?
  module               String?
  currentScenarioIndex Int       @default(0)
  totalScenarios       Int       @default(5)
  attackerReady        Boolean   @default(false)
  defenderReady        Boolean   @default(false)
  scenarioIds          Json?
  attackerScore        Int       @default(0)
  defenderScore        Int       @default(0)
  createdAt            DateTime  @default(now())
  completedAt          DateTime?

  attacker User  @relation("AttackerSessions", fields: [attackerId], references: [id])
  defender User? @relation("DefenderSessions", fields: [defenderId], references: [id])

  attempts Attempt[]
  events   Event[]
  scores   Score[]

  @@map("sessions")
}

model Scenario {
  id             String @id @default(cuid())
  name           String
  description    String
  category       String
  difficulty     String
  targetSystem   String
  context        String
  attackOptions  Json
  defenseOptions Json

  rules    Rule[]
  attempts Attempt[]
  events   Event[]

  @@map("scenarios")
}

model Rule {
  id            String @id @default(cuid())
  scenarioId    String
  attackType    String
  defenseType   String
  outcome       String
  explanation   String
  scoreModifier Int

  scenario Scenario @relation(fields: [scenarioId], references: [id])

  @@map("rules")
}

model Attempt {
  id          String   @id @default(cuid())
  sessionId   String
  scenarioId  String
  userId      String
  role        String
  choice      String
  outcome     String
  score       Int
  timeTaken   Int
  explanation String
  createdAt   DateTime @default(now())

  session  Session  @relation(fields: [sessionId], references: [id])
  scenario Scenario @relation(fields: [scenarioId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  @@map("attempts")
}

model Event {
  id             String   @id @default(cuid())
  turnId         Int
  sessionId      String
  scenarioId     String
  attackerChoice String
  defenderChoice String
  resolvedRule   String
  outcome        String
  score          Int
  timeTaken      Int
  timestamp      DateTime @default(now())

  session  Session  @relation(fields: [sessionId], references: [id])
  scenario Scenario @relation(fields: [scenarioId], references: [id])

  @@map("events")
}

model Score {
  id               String   @id @default(cuid())
  userId           String
  sessionId        String?
  role             String   @default("defender")
  roundNumber      Int?
  totalScore       Int
  correctChoice    Int
  timeEfficiency   Int
  consistency      Int
  repeatedMistakes Int
  createdAt        DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id])
  session Session? @relation(fields: [sessionId], references: [id])

  @@map("scores")
}

model Recommendation {
  id          String   @id @default(cuid())
  userId      String
  type        String
  title       String
  description String
  moduleId    String?
  priority    Int
  isCompleted Boolean  @default(false)
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@map("recommendations")
}

model Analytics {
  id              String   @id @default(cuid())
  userId          String
  category        String
  totalAttempts   Int      @default(0)
  correctAttempts Int      @default(0)
  averageTime     Float    @default(0.0)
  accuracy        Float    @default(0.0)
  lastUpdated     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@map("analytics")
}

model Module {
  id          String @id @default(cuid())
  name        String
  description String
  category    String
  difficulty  String
  duration    Int
  type        String
  content     Json
  order       Int

  lessons Lesson[]

  @@map("modules")
}

model Lesson {
  id       String @id @default(cuid())
  moduleId String
  title    String
  content  String
  type     String
  order    Int

  module Module @relation(fields: [moduleId], references: [id])

  @@map("lessons")
}
