generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String           @id @default(cuid())
  email         String           @unique
  password      String
  name          String
  usn           String?
  department    String?
  semester      Int?
  college       String?
  avatar        String?
  bio           String?
  phone         String?
  location      String?
  preferredRole String?
  timezone      String?
  role          String           @default("USER") // 'USER' | 'ADMIN' — never placed in the JWT; authenticate() reloads this from the DB on every request, so promotion/demotion takes effect immediately without re-login
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  attackerSessions Session[]       @relation("AttackerSessions")
  defenderSessions Session[]       @relation("DefenderSessions")
  attempts         Attempt[]
  scores           Score[]
  recommendations  Recommendation[]
  analytics        Analytics[]
  quizAttempts     QuizAttempt[]
  assessmentSnapshots AssessmentSnapshot[]
  practiceSessions PracticeSession[]

  @@map("users")
}

model Session {
  id                   String    @id @default(cuid())
  sessionCode          String?   @unique
  attackerId           String
  defenderId           String?
  status               String    @default("WAITING_FOR_PARTICIPANT")
  difficulty           String?
  module               String?
  currentScenarioIndex Int       @default(0)
  totalScenarios       Int       @default(5)
  attackerReady        Boolean   @default(false)
  defenderReady        Boolean   @default(false)
  scenarioIds          Json?
  attackerScore        Int       @default(0)
  defenderScore        Int       @default(0)
  createdAt            DateTime  @default(now())
  completedAt          DateTime?

  attacker User  @relation("AttackerSessions", fields: [attackerId], references: [id])
  defender User? @relation("DefenderSessions", fields: [defenderId], references: [id])

  attempts     Attempt[]
  events       Event[]
  scores       Score[]
  assessmentSnapshots AssessmentSnapshot[]
  quizAttempts QuizAttempt[]

  @@map("sessions")
}

model Scenario {
  id             String @id @default(cuid())
  name           String
  description    String
  category       String
  difficulty     String
  targetSystem   String
  context        String
  attackOptions  Json
  defenseOptions Json

  rules    Rule[]
  attempts Attempt[]
  events   Event[]

  @@map("scenarios")
}

model Rule {
  id            String @id @default(cuid())
  scenarioId    String
  attackType    String
  defenseType   String
  outcome       String
  explanation   String
  scoreModifier Int

  scenario Scenario @relation(fields: [scenarioId], references: [id])

  // Guarantees at most one rule row per (scenario, attack, defense) pairing,
  // so runtime resolution can use findUnique (a guaranteed single row or
  // none) instead of findFirst (which does not rule out duplicates).
  @@unique([scenarioId, attackType, defenseType])
  @@map("rules")
}

model Attempt {
  id          String   @id @default(cuid())
  sessionId   String
  scenarioId  String
  userId      String
  role        String
  choice      String
  outcome     String
  score       Int
  timeTaken   Int
  explanation String
  createdAt   DateTime @default(now())

  session  Session  @relation(fields: [sessionId], references: [id])
  scenario Scenario @relation(fields: [scenarioId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  @@map("attempts")
}

model Event {
  id             String   @id @default(cuid())
  turnId         Int
  sessionId      String
  scenarioId     String
  attackerChoice String
  defenderChoice String
  resolvedRule   String
  outcome        String
  score          Int
  timeTaken      Int
  timestamp      DateTime @default(now())

  session  Session  @relation(fields: [sessionId], references: [id])
  scenario Scenario @relation(fields: [scenarioId], references: [id])

  @@map("events")
}

model Score {
  id               String   @id @default(cuid())
  userId           String
  sessionId        String?
  role             String   @default("defender")
  roundNumber      Int?
  totalScore       Int
  correctChoice    Int
  timeEfficiency   Int
  consistency      Int
  repeatedMistakes Int
  createdAt        DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id])
  session Session? @relation(fields: [sessionId], references: [id])

  @@map("scores")
}

// One row per (user, completed session) — written once, at the moment an
// assessment finishes (see sessionActions.advanceRound). This is what backs
// "Performance Over Time" and "Recent Activity" on the Analytics dashboard;
// the Analytics model above is a rolling per-category total updated every
// round, so it has no notion of individual completed assessments or dates.
model AssessmentSnapshot {
  id              String   @id @default(cuid())
  userId          String
  sessionId       String
  role            String // 'attacker' | 'defender'
  module          String?
  totalRounds     Int
  finalScore      Int
  accuracy        Float // % of this role's rounds that were a "win" (breached for attacker, defended for defender)
  correctRounds   Int
  incorrectRounds Int
  averageTime     Float
  completedAt     DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id])
  session Session @relation(fields: [sessionId], references: [id])

  @@map("assessment_snapshots")
}

model Recommendation {
  id          String   @id @default(cuid())
  userId      String
  type        String
  title       String
  description String
  moduleId    String?
  priority    Int
  isCompleted Boolean  @default(false)
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@map("recommendations")
}

model Analytics {
  id              String   @id @default(cuid())
  userId          String
  category        String
  totalAttempts   Int      @default(0)
  correctAttempts Int      @default(0)
  averageTime     Float    @default(0.0)
  accuracy        Float    @default(0.0)
  lastUpdated     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@map("analytics")
}

// Pre-test / Post-test assessment content. Pre and Post draw from the same
// per-(moduleTag, difficulty) pool of 50 questions (see quizEngine.ts) —
// each Scenario Assessment attempt gets its own 8-question sample, with
// repetition-avoidance against the attempt's own Pre-test (when selecting
// Post) and the user's most recent attempt of the same module+difficulty+
// testType. `correctOption` and `explanation` are never sent to the client
// until after an attempt is submitted (see quiz.routes.ts).
model Question {
  id            String  @id @default(cuid())
  questionId    String  @unique // stable external id from the source data (e.g. "q1", "app3")
  question      String
  optionA       String
  optionB       String
  optionC       String
  optionD       String
  correctOption String // 'A' | 'B' | 'C' | 'D'
  topic         String
  moduleTag     String // one of the 5 platform modules — Web Security, Network Security, System Security, Social Engineering, Cryptography
  topicTag      String // normalized topic, e.g. "SQL Injection"
  difficulty    String // 'Easy' | 'Medium' | 'Hard' — exactly 50 questions per (moduleTag, difficulty)
  explanation   String // shown in the Learning Summary review, win or lose
  isActive      Boolean @default(true)

  responses QuizResponse[]

  @@map("questions")
}

// One row per (Session, user, testType) — enforced by the unique index
// below, which is both the idempotency guarantee (refresh/retry can never
// create a duplicate) and the mechanism that makes every new Scenario
// Assessment attempt (= new Session) get its own independent Pre-test and
// Post-test rather than a single account-level checkpoint.
model QuizAttempt {
  id             String    @id @default(cuid())
  userId         String
  sessionId      String? // the Scenario Assessment attempt this belongs to; null only for legacy pre-migration rows
  moduleTag      String? // snapshot of session.module at attempt-creation time ('All Modules' allowed)
  difficulty     String? // snapshot of session.difficulty at attempt-creation time ('All' allowed)
  questionIds    Json? // the 8 selected question ids, fixed for the life of the attempt (resume support)
  testType       String // 'PRE' | 'POST'
  status         String    @default("in_progress") // 'in_progress' | 'completed'
  score          Int? // correct-answer count, computed server-side on submit
  totalQuestions Int
  startedAt      DateTime  @default(now())
  completedAt    DateTime?

  user      User           @relation(fields: [userId], references: [id])
  session   Session?       @relation(fields: [sessionId], references: [id])
  responses QuizResponse[]

  @@unique([sessionId, userId, testType])
  @@map("quiz_attempts")
}

model QuizResponse {
  id             String   @id @default(cuid())
  attemptId      String
  questionId     String
  selectedOption String // 'A' | 'B' | 'C' | 'D'
  isCorrect      Boolean
  createdAt      DateTime @default(now())

  attempt  QuizAttempt @relation(fields: [attemptId], references: [id])
  question Question    @relation(fields: [questionId], references: [id])

  @@unique([attemptId, questionId])
  @@map("quiz_responses")
}

// Practice Labs — a role-neutral, case-study-based MCQ learning module,
// deliberately kept in its own tables rather than reusing
// Question/QuizAttempt/QuizResponse (the Pre/Post-test bank): sharing those
// would risk contaminating the Pre/Post-test's moduleTag+difficulty pool
// selection, and separate tables make analytics isolation structural (nothing in
// analyticsEngine.ts/scoreEngine.ts/reportBuilder.ts/recommendationEngine.ts
// ever touches these) rather than something that has to be remembered.
// `module` matches Scenario.category (validated against it at request
// time) — the module list itself is never duplicated.
//
// Hierarchy: Module -> CaseStudy -> PracticeQuestionPool -> PracticeQuestion.
// Every session picks exactly one CaseStudy and, within it, exactly one
// PracticeQuestionPool, then draws 8 questions from that single pool — see
// practiceEngine.ts.
model CaseStudy {
  id          String  @id @default(cuid())
  module      String // matches Scenario.category
  title       String
  description String // the scenario text shown to the learner before questions
  isActive    Boolean @default(true)

  pools    PracticeQuestionPool[]
  sessions PracticeSession[]

  @@map("case_studies")
}

// A themed slice of questions within one case study (e.g. "Identification",
// "Investigation", "Defense & Mitigation", "Response & Prevention") — pools
// within the same case study test different angles of the same scenario,
// not reshuffled copies of each other.
model PracticeQuestionPool {
  id          String  @id @default(cuid())
  caseStudyId String
  name        String // the angle this pool tests
  isActive    Boolean @default(true)

  caseStudy CaseStudy          @relation(fields: [caseStudyId], references: [id])
  questions PracticeQuestion[]
  sessions  PracticeSession[]

  @@map("practice_question_pools")
}

model PracticeQuestion {
  id            String  @id @default(cuid())
  poolId        String
  module        String // matches Scenario.category — denormalized for simpler module-scoped queries/dedupe checks
  question      String
  optionA       String
  optionB       String
  optionC       String
  optionD       String
  correctOption String // 'A' | 'B' | 'C' | 'D'
  explanation   String
  topicTag      String // specific concept, e.g. "Port Scanning" — for content-diversity checks
  concept       String // 'attacker' | 'defender' | 'both' — metadata only, never a user-facing mode
  difficulty    String  @default("Easy")
  isActive      Boolean @default(true)

  pool      PracticeQuestionPool @relation(fields: [poolId], references: [id])
  responses PracticeResponse[]

  @@map("practice_questions")
}

// One row per practice attempt. Deliberately unrelated to Session/Scenario —
// a practice session is not a Scenario Assessment round.
model PracticeSession {
  id             String    @id @default(cuid())
  userId         String
  module         String
  caseStudyId    String
  poolId         String
  questionIds    Json // the 8 question ids selected at start, fixed for the session
  status         String    @default("in_progress") // 'in_progress' | 'completed'
  score          Int?
  totalQuestions Int
  startedAt      DateTime  @default(now())
  completedAt    DateTime?

  user      User                 @relation(fields: [userId], references: [id])
  caseStudy CaseStudy            @relation(fields: [caseStudyId], references: [id])
  pool      PracticeQuestionPool @relation(fields: [poolId], references: [id])
  responses PracticeResponse[]

  @@map("practice_sessions")
}

model PracticeResponse {
  id             String   @id @default(cuid())
  sessionId      String
  questionId     String
  selectedOption String // 'A' | 'B' | 'C' | 'D'
  isCorrect      Boolean
  createdAt      DateTime @default(now())

  session  PracticeSession  @relation(fields: [sessionId], references: [id])
  question PracticeQuestion @relation(fields: [questionId], references: [id])

  @@unique([sessionId, questionId])
  @@map("practice_responses")
}

model Module {
  id          String @id @default(cuid())
  name        String
  description String
  category    String
  difficulty  String
  duration    Int
  type        String
  content     Json
  order       Int

  lessons Lesson[]

  @@map("modules")
}

model Lesson {
  id       String @id @default(cuid())
  moduleId String
  title    String
  content  String
  type     String
  order    Int

  module Module @relation(fields: [moduleId], references: [id])

  @@map("lessons")
}
