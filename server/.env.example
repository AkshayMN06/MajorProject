# Server configuration. Copy to .env for local development; on Vercel set
# these as project environment variables. Never commit real values.

# PostgreSQL. Runtime connection; on Vercel use Supabase's transaction pooler
# (port 6543) with ?pgbouncer=true&connection_limit=1.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&connection_limit=1"
# Direct/session connection used by `prisma migrate` (Supabase session pooler, port 5432).
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"
# Socket.IO cross-instance adapter (needs LISTEN/NOTIFY — session pooler or direct). Unset locally.
SOCKET_ADAPTER_URL=""

# Long random secret for signing login tokens (required in production).
JWT_SECRET=""
JWT_EXPIRES_IN="7d"

# Browser origins allowed to call the API (comma-separated), and the client URL used in emails.
CORS_ORIGIN="http://localhost:5173"
CLIENT_APP_URL="http://localhost:5173"

# Supabase Storage for module originals (required on Vercel; server-side only).
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
MODULE_FILE_BUCKET="module-files"
# Local storage when Supabase isn't configured.
MODULE_FILE_DIR=""
MODULE_FILE_MAX_MB="15"
MODULE_UPLOAD_MAX_TOTAL_MB="40"
MODULE_EXTRACT_TIMEOUT_MS="20000"

# Password-reset email (optional; without SMTP no email is sent).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="CyberLearn <no-reply@cyberlearn.local>"

# Tests only: a disposable PostgreSQL database (each test file uses its own schema).
TEST_DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:55432/cyberlearn_test"
